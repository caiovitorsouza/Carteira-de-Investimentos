NODE_ENV=development
PORT=3000
# Postgres
DATABASE_URL=postgres://carteira:senha@localhost:5432/carteira
PG_SSL=false
# Brapi (https://brapi.dev). BRAPI_PLAN: free | startup | pro  (pro libera P/VP dos FIIs)
BRAPI_TOKEN=
BRAPI_PLAN=free
BRAPI_BASE_URL=https://brapi.dev
# Motor de cotacoes (horario de pregao, a cada 5 min)
QUOTE_REFRESH_CRON=*/5 10-18 * * 1-5
STALE_SECONDS=120
# Sessao e seguranca
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=0
PUBLIC_ORIGIN=http://localhost:3000
# E-mail transacional (Resend - https://resend.com). Deixe vazio em dev.
RESEND_API_KEY=
EMAIL_FROM=Carteira <onboarding@resend.dev>
EMAIL_ENABLED=false
