{
  "name": "carteira-fullstack",
  "version": "2.0.0",
  "private": true,
  "description": "Carteira de investimentos: Cloudflare Workers + Hono + Supabase + Brapi",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-project.mjs",
    "test:unit": "node tests/unit/run-all.mjs",
    "test:e2e": "node tests/e2e/run-all.mjs",
    "auto:simulate": "node scripts/auto-simulate.mjs once",
    "auto:start": "node scripts/auto-simulate.mjs watch",
    "auto:stop": "node scripts/auto-simulate.mjs stop",
    "auto:pause": "node scripts/auto-simulate.mjs pause",
    "auto:resume": "node scripts/auto-simulate.mjs resume",
    "auto:status": "node scripts/auto-simulate.mjs status",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "sync:instruments": "node --env-file=.env scripts/sync-instruments.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "playwright": "1.64.0",
    "wrangler": "^3.100.0"
  }
}
